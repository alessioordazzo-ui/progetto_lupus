<VoteScreen>:

    MDBoxLayout:
        orientation: "vertical"
        padding: "16dp"
        spacing: "12dp"

        MDLabel:
            text: "VOTAZIONE"
            halign: "center"
            font_style: "H4"
            bold: True
            size_hint_y: None
            height: "55dp"

        MDLabel:
            text: root.vote_status_message
            halign: "center"
            font_style: "Body1"
            theme_text_color: "Error" if root.is_local_silenced else "Secondary"
            size_hint_y: None
            height: "65dp"

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                id: players_list
                orientation: "vertical"
                spacing: "10dp"
                size_hint_y: None
                height: self.minimum_height

        MDLabel:
            text: "Selezionato: " + root.selected_player if root.selected_player else "Nessun giocatore selezionato"
            halign: "center"
            font_style: "H6"
            size_hint_y: None
            height: "50dp"

        MDRaisedButton:
            text: "CONFERMA VOTO"
            pos_hint: {"center_x": .5}
            size_hint_y: None
            height: "50dp"
            disabled: not root.selected_player or not root.can_local_vote
            on_release: root.confirm_vote()

        MDFlatButton:
            text: "PROSEGUI SENZA VOTARE"
            pos_hint: {"center_x": .5}
            size_hint_y: None
            height: "50dp"
            on_release: root.skip_vote()