<SplashScreen>:

    canvas.before:
        Color:
            rgba: 0.10, 0.10, 0.10, 1
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:

        Image:
            source: "assets/images/logos/logo.png"
            size_hint: 0.35, 0.35
            pos_hint: {"center_x": 0.5, "center_y": 0.68}

        Label:
            text: "LUPUS"
            font_size: "42sp"
            bold: True
            color: 1, 1, 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.42}

        Label:
            text: "The Village Awakens"
            font_size: "18sp"
            color: 0.8, 0.8, 0.8, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.35}

        Label:
            text: "Loading..."
            font_size: "16sp"
            color: 0.6, 0.6, 0.6, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.12}