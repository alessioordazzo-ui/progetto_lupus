<LupusPlayerCard>:

    orientation: "horizontal"

    size_hint_y: None
    height: "80dp"

    padding: "12dp"
    spacing: "12dp"

    canvas.before:
        Color:
            rgba: (.12, .12, .12, 1)

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16]

    # ICONA HOST / GIOCATORE
    MDLabel:
        text: "👑" if root.host else "🙂"

        size_hint_x: None
        width: "45dp"

        halign: "center"
        valign: "middle"

        font_style: "H6"

    # INFORMAZIONI GIOCATORE
    MDBoxLayout:

        orientation: "vertical"

        spacing: "2dp"

        MDLabel:
            text: root.player_name

            font_style: "H6"

            bold: True

            theme_text_color: "Primary"

            valign: "middle"

        MDLabel:
            text: root.role

            font_style: "Body2"

            theme_text_color: "Secondary"

            valign: "middle"

    # STATO READY
    MDLabel:
        text: "✓ PRONTO" if root.ready else "IN ATTESA"

        size_hint_x: None
        width: "100dp"

        halign: "center"
        valign: "middle"

        font_style: "Caption"

        theme_text_color: "Custom"

        text_color: (0, 0.8, 0, 1) if root.ready else (0.7, 0.7, 0.7, 1)
