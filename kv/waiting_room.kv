<WaitingRoomScreen>:

    MDBoxLayout:
        orientation: "vertical"

        padding: "16dp"
        spacing: "12dp"


        # =========================
        # TITOLO
        # =========================

        MDLabel:
            text: "SALA D'ATTESA"

            halign: "center"

            font_style: "H4"

            bold: True

            size_hint_y: None
            height: "55dp"


        # =========================
        # CODICE LOBBY
        # =========================

        LupusLobbyCode:
            lobby_code: "X4J8PQ"

            size_hint_y: None
            height: "140dp"


        # =========================
        # INFORMAZIONI GIOCATORI
        # =========================

        MDLabel:
            text: "GIOCATORI  " + str(root.player_count) + "/" + str(root.max_players)

            font_style: "H6"

            bold: True

            size_hint_y: None
            height: "40dp"


        # =========================
        # LISTA GIOCATORI
        # =========================

        ScrollView:

            do_scroll_x: False

            bar_width: "4dp"

            MDBoxLayout:

                orientation: "vertical"

                size_hint_y: None

                height: self.minimum_height

                spacing: "8dp"


                LupusPlayerCard:
                    player_name: "Alessio"
                    role: "Host"
                    host: True
                    ready: root.player_ready


                LupusPlayerCard:
                    player_name: "Marco"
                    role: "Giocatore"
                    ready: False


                LupusPlayerCard:
                    player_name: "Luca"
                    role: "Giocatore"
                    ready: True


                LupusPlayerCard:
                    player_name: "Sara"
                    role: "Giocatore"
                    ready: True


                LupusPlayerCard:
                    player_name: "Giulia"
                    role: "Giocatore"
                    ready: False


                LupusPlayerCard:
                    player_name: "Davide"
                    role: "Giocatore"
                    ready: True


                LupusPlayerCard:
                    player_name: "Francesco"
                    role: "Giocatore"
                    ready: False


                LupusPlayerCard:
                    player_name: "Elena"
                    role: "Giocatore"
                    ready: True


                LupusPlayerCard:
                    player_name: "Matteo"
                    role: "Giocatore"
                    ready: True


                LupusPlayerCard:
                    player_name: "Chiara"
                    role: "Giocatore"
                    ready: False


        # =========================
        # PULSANTI
        # =========================

        MDBoxLayout:

            orientation: "horizontal"

            spacing: "10dp"

            size_hint_y: None
            height: "55dp"


            MDRaisedButton:

                text: "PRONTO" if not root.player_ready else "NON PRONTO"

                size_hint_x: 0.5

                on_release:
                    root.toggle_ready()


            MDRaisedButton:

                text: "AVVIA PARTITA"

                size_hint_x: 0.5

                on_release:
                    root.start_game()