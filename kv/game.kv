<GameScreen>:

    MDBoxLayout:
        orientation: "vertical"
        padding: "16dp"
        spacing: "12dp"

        # =========================
        # TITOLO
        # =========================

        MDLabel:
            text: "LUPUS"
            halign: "center"
            font_style: "H4"
            bold: True
            size_hint_y: None
            height: "55dp"

        # =========================
        # GIORNO / NOTTE
        # =========================

        MDLabel:
            text: root.phase.upper() + " " + str(root.day_number)
            halign: "center"
            font_style: "H5"
            bold: True
            size_hint_y: None
            height: "50dp"

        # =========================
        # RUOLO DEL GIOCATORE
        # =========================

        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "8dp"
            size_hint_y: None
            height: "120dp"

            canvas.before:
                Color:
                    rgba: (.12, .12, .12, 1)

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]

            MDLabel:
                text: "IL TUO RUOLO"
                halign: "center"
                font_style: "Subtitle1"

            MDLabel:
                id: role_label
                text: root.local_player_role
                halign: "center"
                font_style: "H5"
                bold: True

        # =========================
        # DESCRIZIONE FASE
        # =========================

        MDLabel:
            text: "È GIORNO: preparati alla discussione e alla votazione." if root.phase == "giorno" else "È NOTTE: attendi le azioni notturne."
            halign: "center"
            font_style: "Body1"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: "45dp"

        # =========================
        # TITOLO LISTA GIOCATORI
        # =========================

        MDLabel:
            text: "GIOCATORI"
            font_style: "H6"
            bold: True
            size_hint_y: None
            height: "40dp"

        # =========================
        # LISTA GIOCATORI
        # =========================

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                id: players_list
                orientation: "vertical"
                spacing: "8dp"
                size_hint_y: None
                height: self.minimum_height

        # =========================
        # AZIONE PRINCIPALE
        # =========================

        MDBoxLayout:
            orientation: "horizontal"
            spacing: "10dp"
            size_hint_y: None
            height: "50dp"

            MDRaisedButton:
                text: "VOTAZIONE" if root.phase == "giorno" else "AZIONI NOTTURNE"
                size_hint_x: 1

                on_release:
                    root.open_vote() if root.phase == "giorno" else root.open_night()